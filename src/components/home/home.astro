---
import '../../styles/home.css'
import { events, featured, type Lang } from '../../data/events'
import { ui, langs, DISCORD, GITHUB } from '../../i18n/ui'

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const site = 'https://vim.kr'
const current = langs.find((l) => l.code === lang)!

const fmtDate = (d: string) =>
    new Intl.DateTimeFormat(
        lang === 'ko' ? 'ko-KR' : lang === 'ja' ? 'ja-JP' : 'en-US',
        {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
        }
    ).format(new Date(d + 'T00:00:00'))

// `x` 를 키캡으로 바꾼다
const keycaps = (s: string) =>
    s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/`([^`]+)`/g, '<kbd>$1</kbd>')
        .replace(/\n/g, '<br />')

const photos = events.flatMap((e) =>
    e.photos.map((p) => ({ ...p, event: e.id, name: e.name, date: e.date }))
)
const galleryFilters = events.filter((e) => e.photos.length > 0)
const pastEvents = events.filter((e) => e.id !== featured.id)
const pageData = JSON.stringify({
    lang,
    cmd: t.cmd,
    langs: langs.map((l) => [l.code, l.path]),
    typed: t.heroTyped,
})
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{t.metaTitle}</title>
        <meta name="description" content={t.metaDesc} />
        <meta name="theme-color" content="#ffffff" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="canonical" href={site + current.path} />
        {
            langs.map((l) => (
                <link rel="alternate" hreflang={l.code} href={site + l.path} />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={site + '/'} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={t.metaTitle} />
        <meta property="og:description" content={t.metaDesc} />
        <meta property="og:url" content={site + current.path} />
        <meta
            property="og:image"
            content={site + '/events/vimrc-2025/11.webp'}
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Nanum+Gothic+Coding:wght@400;700&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
        />
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-Y2Y08PZHV2"
        ></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || []
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', 'G-Y2Y08PZHV2')
        </script>
    </head>
    <body data-page={pageData}>
        <!-- tabline: Vim 기본 TabLine 모양 -->
        <nav class="tabline" aria-label="Menu">
            <a class="brand" href={current.path}>
                <img src="/vimkr.png" alt="" width="22" height="22" />
                <span class="brand-name">vim.kr</span>
            </a>
            <div class="tabs">
                {
                    (['start', 'events', 'gallery', 'join'] as const).map(
                        (k, i) => (
                            <a class="tab" href={`#${k}`} data-tab={k}>
                                <span class="tab-n">{i + 1}</span>
                                {t.nav[k]}
                            </a>
                        )
                    )
                }
            </div>
            <div class="tab-right">
                <div class="langs">
                    {
                        langs.map((l) => (
                            <a
                                href={l.path}
                                hreflang={l.code}
                                lang={l.code}
                                aria-current={
                                    l.code === lang ? 'true' : undefined
                                }
                            >
                                {l.code}
                            </a>
                        ))
                    }
                </div>
                <a class="btn-tab" href={DISCORD} target="_blank" rel="noopener"
                    >{t.discord}</a
                >
            </div>
        </nav>

        <main id="main">
            <!-- hero: 입력 모드에서 제목을 타이핑하는 창 -->
            <section class="hero win" data-section="top" id="top">
                <div class="win-body">
                    <div class="hero-text">
                        <p class="c-comment ln-row">" {t.heroKicker}</p>
                        <h1 aria-label={t.heroTyped.join(' ')}>
                            {
                                t.heroTyped.map((line) => (
                                    <span class="typed ln-row" data-text={line}>
                                        {line}
                                    </span>
                                ))
                            }
                        </h1>
                        <p class="hero-body">
                            {
                                t.heroBody.map((l) => (
                                    <span class="ln-row">{l}</span>
                                ))
                            }
                        </p>
                        <div class="hero-actions ln-row">
                            <a class="btn btn-rev" href="#try"
                                >{t.heroCta} <kbd class="kbd-inv">⏎</kbd></a
                            >
                            <a class="btn" href="#start">{t.nav.start}</a>
                        </div>
                        <ul class="facts ln-row">
                            {t.facts.map((f) => <li>{f}</li>)}
                        </ul>
                    </div>
                </div>
                <div class="win-status">
                    <span>hello.txt</span>
                    <span class="win-pos" id="hero-pos">1,1</span>
                </div>
                <div class="win-msg" id="hero-msg"><b>-- INSERT --</b></div>
            </section>

            <!-- 연습 화면 -->
            <section class="pg" id="try" data-section="top">
                <div class="pg-head">
                    {
                        t.pg.lessons.map((l, i) => (
                            <div
                                class="pg-lesson"
                                data-lesson={i}
                                hidden={i !== 0}
                            >
                                <p class="pg-title">
                                    <span class="pg-count">
                                        {i + 1}/{t.pg.lessons.length}
                                    </span>
                                    {l.title}
                                </p>
                                <p class="pg-body" set:html={keycaps(l.body)} />
                                <p class="pg-success" data-success hidden>
                                    ✓ {l.success}
                                </p>
                            </div>
                        ))
                    }
                    <div class="pg-lesson" data-lesson="done" hidden>
                        <p class="pg-title">{t.pg.doneTitle}</p>
                        <p class="pg-body">
                            {t.pg.doneBody.join(' ')}
                            <code class="code-chip">$ vimtutor</code>
                        </p>
                    </div>
                    <ol class="pg-dots">
                        {
                            t.pg.lessons.map((l, i) => (
                                <li>
                                    <button
                                        type="button"
                                        data-goto={i}
                                        aria-label={`${i + 1}. ${l.title}`}
                                    />
                                </li>
                            ))
                        }
                    </ol>
                </div>
                <div class="pg-editor win">
                    <div class="pg-buf" aria-hidden="true"></div>
                    <div class="win-status">
                        <span>practice.txt</span>
                        <span class="win-pos" data-pos>1,1</span>
                    </div>
                    <div class="win-msg" data-msg></div>
                    <textarea
                        class="pg-input"
                        aria-label={t.pg.label}
                        autocapitalize="off"
                        autocomplete="off"
                        spellcheck="false"></textarea>
                    <button type="button" class="pg-start">{t.pg.start}</button>
                </div>
                <div class="kb" aria-label="keyboard"></div>
                <div class="pg-nav">
                    <button type="button" data-act="prev">← {t.pg.prev}</button>
                    <button type="button" data-act="reset">{t.pg.reset}</button>
                    <button type="button" data-act="next">{t.pg.next} →</button>
                </div>
            </section>

            <!-- 최근 행사 영상 -->
            <section class="latest" data-section="events">
                <div class="video-frame">
                    <iframe
                        src={`https://www.youtube-nocookie.com/embed/${featured.video}?rel=0`}
                        title={featured.talks[0].title}
                        loading="lazy"
                        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen></iframe>
                </div>
                <div class="latest-text">
                    <p class="kicker">
                        <mark>{t.latestKicker}</mark>
                        {fmtDate(featured.date)}
                    </p>
                    <h2>{featured.talks[0].title}</h2>
                    <p>{featured.summary[lang]}</p>
                    <p class="links">
                        {
                            featured.links.map((l) => (
                                <a href={l.href} target="_blank" rel="noopener">
                                    {l.label[lang]} ↗
                                </a>
                            ))
                        }
                    </p>
                </div>
            </section>

            <!-- 처음이라면 -->
            <section class="sec" id="start" data-section="start">
                <h2 class="sec-title">
                    {t.startTitle}
                </h2>
                <ol class="steps">
                    {
                        t.steps.map((s, i) => (
                            <li class="step">
                                <kbd class="step-n">{i + 1}</kbd>
                                <h3>{s.title}</h3>
                                <p set:html={keycaps(s.body)} />
                                {s.code && (
                                    <button
                                        type="button"
                                        class="code-chip copy"
                                        data-copy={s.code}
                                        data-done={t.copied}
                                    >
                                        $ {s.code}{' '}
                                        <span class="copy-label">{t.copy}</span>
                                    </button>
                                )}
                                {s.link && (
                                    <a
                                        href={s.link.href}
                                        target={
                                            s.link.href.startsWith('http')
                                                ? '_blank'
                                                : undefined
                                        }
                                        rel="noopener"
                                    >
                                        {s.link.label} →
                                    </a>
                                )}
                            </li>
                        ))
                    }
                </ol>
            </section>

            <!-- 행사 -->
            <section class="sec" id="events" data-section="events">
                <h2 class="sec-title">
                    {t.eventsTitle}
                </h2>
                <p class="lead">
                    {t.eventsLead.map((l) => <span class="line">{l}</span>)}
                </p>
                <div class="event-list">
                    {
                        pastEvents.map((e, i) => (
                            <details class="event" id={e.id} open={i === 0}>
                                <summary>
                                    <span class="ev-year">
                                        {e.date.slice(0, 4)}
                                    </span>
                                    <span class="ev-name">{e.name}</span>
                                    <span class="ev-meta">
                                        {e.talks.length > 0 && (
                                            <span>
                                                {t.talks(e.talks.length)}
                                            </span>
                                        )}
                                        {e.photos.length > 0 && (
                                            <span>
                                                {t.photos(e.photos.length)}
                                            </span>
                                        )}
                                    </span>
                                    <span
                                        class="ev-toggle"
                                        aria-hidden="true"
                                    />
                                </summary>
                                <div class="ev-body">
                                    <p class="ev-summary">{e.summary[lang]}</p>
                                    <p class="links">
                                        {e.links.map((l) => (
                                            <a
                                                href={l.href}
                                                target="_blank"
                                                rel="noopener"
                                            >
                                                {l.label[lang]} ↗
                                            </a>
                                        ))}
                                        {e.photos.length > 0 && (
                                            <a
                                                href="#gallery"
                                                data-filter-link={e.id}
                                            >
                                                {t.seePhotos} →
                                            </a>
                                        )}
                                    </p>
                                    {e.talks.some((tk) => tk.youtube) ? (
                                        <ul class="talk-grid">
                                            {e.talks.map((tk) => (
                                                <li class="talk">
                                                    <button
                                                        class="yt"
                                                        type="button"
                                                        data-yt={tk.youtube}
                                                        aria-label={`${t.play}: ${tk.title}`}
                                                    >
                                                        <img
                                                            src={`https://i.ytimg.com/vi/${tk.youtube}/mqdefault.jpg`}
                                                            alt=""
                                                            loading="lazy"
                                                            width="320"
                                                            height="180"
                                                        />
                                                        <span
                                                            class="yt-play"
                                                            aria-hidden="true"
                                                        >
                                                            ▶
                                                        </span>
                                                    </button>
                                                    <p class="talk-title">
                                                        {tk.title}
                                                    </p>
                                                    {tk.speaker && (
                                                        <p class="talk-speaker">
                                                            {tk.speaker}
                                                        </p>
                                                    )}
                                                </li>
                                            ))}
                                        </ul>
                                    ) : (
                                        e.talks.length > 0 && (
                                            <ul class="talk-tags">
                                                {e.talks.map((tk) => (
                                                    <li>{tk.title}</li>
                                                ))}
                                            </ul>
                                        )
                                    )}
                                </div>
                            </details>
                        ))
                    }
                </div>
            </section>

            <!-- 사진 -->
            <section class="sec" id="gallery" data-section="gallery">
                <h2 class="sec-title">
                    {t.galleryTitle}
                </h2>
                <div class="filters" role="group">
                    <button type="button" data-filter="all" aria-pressed="true"
                        >{t.galleryAll} <span>{photos.length}</span></button
                    >
                    {
                        galleryFilters.map((e) => (
                            <button
                                type="button"
                                data-filter={e.id}
                                aria-pressed="false"
                            >
                                {e.name} <span>{e.photos.length}</span>
                            </button>
                        ))
                    }
                </div>
                <div class="masonry">
                    {
                        photos.map((p, i) => (
                            <a
                                class="shot"
                                href={p.src}
                                data-event={p.event}
                                data-caption={`${p.name}, ${fmtDate(p.date)}`}
                            >
                                <img
                                    src={p.thumb ?? p.src}
                                    alt={`${p.name} #${i + 1}`}
                                    loading="lazy"
                                />
                            </a>
                        ))
                    }
                </div>
            </section>

            <!-- 함께하기 -->
            <section class="sec join" id="join" data-section="join">
                <h2 class="sec-title">
                    {t.joinTitle}
                </h2>
                <p class="lead">
                    {t.joinBody.map((l) => <span class="line">{l}</span>)}
                </p>
                <a
                    class="btn btn-rev btn-lg"
                    href={DISCORD}
                    target="_blank"
                    rel="noopener"
                    >{t.joinButton} <kbd class="kbd-inv">⏎</kbd></a
                >
            </section>

            <footer class="foot">
                <p class="tildes" aria-hidden="true">~<br />~<br />~</p>
                <p class="links">
                    <a href="/vim-as-ide/kickstart/">{t.footerDocs}</a>
                    <a href={GITHUB} target="_blank" rel="noopener"
                        >{t.footerCode} ↗</a
                    >
                    <a href={DISCORD} target="_blank" rel="noopener"
                        >Discord ↗</a
                    >
                </p>
            </footer>
        </main>

        <!-- 페이지 상태줄과 명령줄 -->
        <div class="bottom">
            <ul class="wildmenu" id="wildmenu" hidden>
                {
                    t.cmd.list.map(([c, d]) => (
                        <li>
                            <button type="button" data-cmd={c}>
                                <b>:{c}</b> <span>{d}</span>
                            </button>
                        </li>
                    ))
                }
            </ul>
            <div class="statusline">
                <span class="mode" id="sl-mode">NORMAL</span>
                <span class="sl-file">vim.kr/{lang}</span>
                <span class="sl-right"
                    ><span class="sl-keys">{t.cmd.keys}</span><span id="sl-pct"
                        >Top</span
                    ></span
                >
            </div>
            <form class="cmdline" id="cmdline" autocomplete="off">
                <button type="button" class="cmd-hint" id="cmd-hint">
                    <kbd>:</kbd>
                    <span class="hint-key">{t.cmd.hint}</span>
                    <span class="hint-touch">{t.cmd.touch}</span>
                </button>
                <label class="cmd-wrap" hidden>
                    <span>:</span>
                    <input
                        id="cmd-input"
                        spellcheck="false"
                        autocapitalize="off"
                        aria-label="command"
                    />
                </label>
            </form>
        </div>

        <dialog class="lightbox" id="lightbox" aria-label={t.galleryTitle}>
            <img id="lb-img" alt="" />
            <p class="lb-cap">
                <span id="lb-pos"></span>
                <span id="lb-cap"></span>
            </p>
            <button
                type="button"
                class="lb-btn lb-prev"
                data-lb="prev"
                aria-label={t.lightbox.prev}>h</button
            >
            <button
                type="button"
                class="lb-btn lb-next"
                data-lb="next"
                aria-label={t.lightbox.next}>l</button
            >
            <button
                type="button"
                class="lb-btn lb-close"
                data-lb="close"
                aria-label={t.lightbox.close}>:q</button
            >
        </dialog>

        <script>
            import { initHome } from '../../scripts/home'
            import { initPlayground } from '../../scripts/playground'
            initHome()
            initPlayground()
        </script>
    </body>
</html>
