---
import Base from './base.astro'
import { events, featured, type Lang } from '../../data/events'
import { ui, langs, DISCORD } from '../../i18n/ui'

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]

const fmtDate = (d: string) =>
    new Intl.DateTimeFormat(
        lang === 'ko' ? 'ko-KR' : lang === 'ja' ? 'ja-JP' : 'en-US',
        {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
        }
    ).format(new Date(d + 'T00:00:00'))

// `x` 를 키캡으로 바꾼다
const keycaps = (s: string) =>
    s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/`([^`]+)`/g, '<kbd>$1</kbd>')
        .replace(/\n/g, '<br />')

const photos = events.flatMap((e) =>
    e.photos.map((p) => ({ ...p, event: e.id, name: e.name, date: e.date }))
)
const galleryFilters = events.filter((e) => e.photos.length > 0)
const listPath = langs.find((l) => l.code === lang)!.path + 'events/'
const pastEvents = events.filter((e) => e.id !== featured.id)
---

<Base lang={lang} title={t.metaTitle} desc={t.metaDesc}>
    <main id="main">
        <!-- hero: 입력 모드에서 제목을 타이핑하는 창 -->
        <section class="hero win" data-section="top" id="top">
            <div class="win-body">
                <div class="hero-text">
                    <p class="c-comment ln-row">" {t.heroKicker}</p>
                    <h1 aria-label={t.heroTyped.join(' ')}>
                        {
                            t.heroTyped.map((line) => (
                                <span class="typed ln-row" data-text={line}>
                                    {line}
                                </span>
                            ))
                        }
                    </h1>
                    <div class="hero-actions ln-row">
                        <a class="btn btn-rev" href="#try"
                            >{t.heroCta} <kbd class="kbd-inv">⏎</kbd></a
                        >
                        <a class="btn" href="#start">{t.nav.start}</a>
                    </div>
                    <ul class="facts ln-row">
                        {
                            t.facts.map((f) => (
                                <li>
                                    {f}, <a href={listPath}>{t.factsLink} →</a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
            <div class="win-status">
                <span>hello.txt</span>
                <span class="win-pos" id="hero-pos">1,1</span>
            </div>
            <div class="win-msg" id="hero-msg"><b>-- INSERT --</b></div>
        </section>

        <!-- 연습 화면 -->
        <section class="pg" id="try" data-section="top">
            <div class="pg-head">
                {
                    t.pg.lessons.map((l, i) => (
                        <div class="pg-lesson" data-lesson={i} hidden={i !== 0}>
                            <p class="pg-title">
                                <span class="pg-count">
                                    {i + 1}/{t.pg.lessons.length}
                                </span>
                                {l.title}
                            </p>
                            <p class="pg-body" set:html={keycaps(l.body)} />
                            <p class="pg-success" data-success hidden>
                                ✓ {l.success}
                            </p>
                        </div>
                    ))
                }
                <div class="pg-lesson" data-lesson="done" hidden>
                    <p class="pg-title">{t.pg.doneTitle}</p>
                    <p class="pg-body">
                        {t.pg.doneBody.join(' ')}
                        <code class="code-chip">$ vimtutor</code>
                    </p>
                </div>
                <ol class="pg-dots">
                    {
                        t.pg.lessons.map((l, i) => (
                            <li>
                                <button
                                    type="button"
                                    data-goto={i}
                                    aria-label={`${i + 1}. ${l.title}`}
                                />
                            </li>
                        ))
                    }
                </ol>
            </div>
            <div class="pg-editor win">
                <div class="pg-buf" aria-hidden="true"></div>
                <div class="win-status">
                    <span>practice.txt</span>
                    <span class="win-pos" data-pos>1,1</span>
                </div>
                <div class="win-msg" data-msg></div>
                <textarea
                    class="pg-input"
                    aria-label={t.pg.label}
                    autocapitalize="off"
                    autocomplete="off"
                    spellcheck="false"></textarea>
                <button type="button" class="pg-start">{t.pg.start}</button>
            </div>
            <div class="kb" aria-label="keyboard"></div>
            <div class="pg-nav">
                <button type="button" data-act="prev">← {t.pg.prev}</button>
                <button type="button" data-act="reset">{t.pg.reset}</button>
                <button type="button" data-act="next">{t.pg.next} →</button>
            </div>
        </section>

        <!-- 최근 행사 영상 -->
        <section class="latest" data-section="events">
            <div class="video-frame">
                <iframe
                    src={`https://www.youtube-nocookie.com/embed/${featured.video}?rel=0`}
                    title={featured.talks[0].title}
                    loading="lazy"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen></iframe>
            </div>
            <div class="latest-text">
                <p class="kicker">
                    <mark>{t.latestKicker}</mark>
                    {fmtDate(featured.date)}
                </p>
                <h2>{featured.talks[0].title}</h2>
                <p>{featured.summary[lang]}</p>
                <p class="links">
                    {
                        featured.signup && (
                            <a
                                href={featured.signup}
                                target="_blank"
                                rel="noopener"
                            >
                                {t.signup} ↗
                            </a>
                        )
                    }
                    {
                        featured.links.map((l) => (
                            <a href={l.href} target="_blank" rel="noopener">
                                {l.label[lang]} ↗
                            </a>
                        ))
                    }
                </p>
            </div>
        </section>

        <!-- 처음이라면 -->
        <section class="sec" id="start" data-section="start">
            <h2 class="sec-title">
                {t.startTitle}
            </h2>
            <ol class="steps">
                {
                    t.steps.map((s, i) => (
                        <li class="step">
                            <kbd class="step-n">{i + 1}</kbd>
                            <h3>{s.title}</h3>
                            <p set:html={keycaps(s.body)} />
                            {s.code && (
                                <button
                                    type="button"
                                    class="code-chip copy"
                                    data-copy={s.code}
                                    data-done={t.copied}
                                >
                                    $ {s.code}{' '}
                                    <span class="copy-label">{t.copy}</span>
                                </button>
                            )}
                            {s.link && (
                                <a
                                    href={s.link.href}
                                    target={
                                        s.link.href.startsWith('http')
                                            ? '_blank'
                                            : undefined
                                    }
                                    rel="noopener"
                                >
                                    {s.link.label} →
                                </a>
                            )}
                        </li>
                    ))
                }
            </ol>
        </section>

        <!-- 행사 -->
        <section class="sec" id="events" data-section="events">
            <h2 class="sec-title">
                {t.eventsTitle}
            </h2>
            <p class="lead">
                {t.eventsLead.map((l) => <span class="line">{l}</span>)}
            </p>
            <div class="event-list">
                {
                    pastEvents.map((e, i) => (
                        <details class="event" id={e.id} open={i === 0}>
                            <summary>
                                <span class="ev-year">
                                    {e.date.slice(0, 4)}
                                </span>
                                <span class="ev-name">{e.name}</span>
                                <span class="ev-meta">
                                    {e.talks.length > 0 && (
                                        <span>{t.talks(e.talks.length)}</span>
                                    )}
                                    {e.photos.length > 0 && (
                                        <span>{t.photos(e.photos.length)}</span>
                                    )}
                                </span>
                                <span class="ev-toggle" aria-hidden="true" />
                            </summary>
                            <div class="ev-body">
                                <p class="ev-summary">{e.summary[lang]}</p>
                                <p class="links">
                                    {e.signup && (
                                        <a
                                            href={e.signup}
                                            target="_blank"
                                            rel="noopener"
                                        >
                                            {t.signup} ↗
                                        </a>
                                    )}
                                    {e.links.map((l) => (
                                        <a
                                            href={l.href}
                                            target="_blank"
                                            rel="noopener"
                                        >
                                            {l.label[lang]} ↗
                                        </a>
                                    ))}
                                    {e.photos.length > 0 && (
                                        <a
                                            href="#gallery"
                                            data-filter-link={e.id}
                                        >
                                            {t.seePhotos} →
                                        </a>
                                    )}
                                </p>
                                {e.talks.some((tk) => tk.youtube) ? (
                                    <ul class="talk-grid">
                                        {e.talks.map((tk) => (
                                            <li class="talk">
                                                <button
                                                    class="yt"
                                                    type="button"
                                                    data-yt={tk.youtube}
                                                    aria-label={`${t.play}: ${tk.title}`}
                                                >
                                                    <img
                                                        src={`https://i.ytimg.com/vi/${tk.youtube}/mqdefault.jpg`}
                                                        alt=""
                                                        loading="lazy"
                                                        width="320"
                                                        height="180"
                                                    />
                                                    <span
                                                        class="yt-play"
                                                        aria-hidden="true"
                                                    >
                                                        ▶
                                                    </span>
                                                </button>
                                                <p class="talk-title">
                                                    {tk.title}
                                                </p>
                                                {tk.speaker && (
                                                    <p class="talk-speaker">
                                                        {tk.speaker}
                                                    </p>
                                                )}
                                            </li>
                                        ))}
                                    </ul>
                                ) : (
                                    e.talks.length > 0 && (
                                        <ul class="talk-tags">
                                            {e.talks.map((tk) => (
                                                <li>{tk.title}</li>
                                            ))}
                                        </ul>
                                    )
                                )}
                            </div>
                        </details>
                    ))
                }
            </div>
        </section>

        <!-- 사진 -->
        <section class="sec" id="gallery" data-section="gallery">
            <h2 class="sec-title">
                {t.galleryTitle}
            </h2>
            <div class="filters" role="group">
                <button type="button" data-filter="all" aria-pressed="true"
                    >{t.galleryAll} <span>{photos.length}</span></button
                >
                {
                    galleryFilters.map((e) => (
                        <button
                            type="button"
                            data-filter={e.id}
                            aria-pressed="false"
                        >
                            {e.name} <span>{e.photos.length}</span>
                        </button>
                    ))
                }
            </div>
            <div class="masonry">
                {
                    photos.map((p, i) => (
                        <a
                            class="shot"
                            href={p.src}
                            data-event={p.event}
                            data-caption={`${p.name}, ${fmtDate(p.date)}`}
                        >
                            <img
                                src={p.thumb ?? p.src}
                                alt={`${p.name} #${i + 1}`}
                                loading="lazy"
                            />
                        </a>
                    ))
                }
            </div>
        </section>

        <!-- 함께하기 -->
        <section class="sec join" id="join" data-section="join">
            <h2 class="sec-title">
                {t.joinTitle}
            </h2>
            <p class="lead">
                {t.joinBody.map((l) => <span class="line">{l}</span>)}
            </p>
            <a
                class="btn btn-rev btn-lg"
                href={DISCORD}
                target="_blank"
                rel="noopener">{t.joinButton} <kbd class="kbd-inv">⏎</kbd></a
            >
        </section>

        <footer class="foot">
            <p class="tildes" aria-hidden="true">~<br />~<br />~</p>
            <p class="links">
                <a href={DISCORD} target="_blank" rel="noopener">Discord ↗</a>
            </p>
        </footer>
    </main>

    <dialog class="lightbox" id="lightbox" aria-label={t.galleryTitle}>
        <img id="lb-img" alt="" />
        <p class="lb-cap">
            <span id="lb-pos"></span>
            <span id="lb-cap"></span>
        </p>
        <button
            type="button"
            class="lb-btn lb-prev"
            data-lb="prev"
            aria-label={t.lightbox.prev}>h</button
        >
        <button
            type="button"
            class="lb-btn lb-next"
            data-lb="next"
            aria-label={t.lightbox.next}>l</button
        >
        <button
            type="button"
            class="lb-btn lb-close"
            data-lb="close"
            aria-label={t.lightbox.close}>:q</button
        >
    </dialog>

    <script>
        import { initHome } from '../../scripts/home'
        import { initPlayground } from '../../scripts/playground'
        initHome()
        initPlayground()
    </script>
</Base>
